    local maxVal = tonumber(TestMaxBox.Text)
    if not maxVal or maxVal < 1 then
        TestCustomBtn.Text = "❌ Lỗi: Nhập max hợp lệ!"
        task.wait(1.5)
        TestCustomBtn.Text = "⚡ Test Nhanh: 1 -> (Tự Chọn)"
        return
    }

    isTestingCustom = true
    TestCustomBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
    
    task.spawn(function()
        pcall(function()
            -- Tạo danh sách các mốc tự động từ 1 cho đến maxVal
            local milestones = {1}
            local current = 10
            while current <= maxVal do
                table.insert(milestones, current)
                current = current * 10
            end
            if milestones[#milestones] < maxVal then
                table.insert(milestones, maxVal)
            end

            for _, v in ipairs(milestones) do
                if not isTestingCustom then break end
                BoostEvent:FireServer(v)
                TestCustomBtn.Text = "⚡ Đang Test: " .. tostring(v)
                task.wait(0.05)
            end
        end)
        
        TestCustomBtn.Text = "✅ Đã Test Xong!"
        task.wait(1.5)
        TestCustomBtn.Text = "⚡ Test Nhanh: 1 -> (Tự Chọn)"
        TestCustomBtn.BackgroundColor3 = Color3.fromRGB(142, 68, 173)
        isTestingCustom = false
    end)
end)

